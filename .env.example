GEMINI_API_KEY=

# Neo4j AuraDB Free
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://<DB_ID>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<AURA_DB_PASSWORD>
# AuraDB Free의 홈 DB명이 neo4j가 아닐 수 있으므로 Connect 정보나 SHOW DATABASES 결과를 사용한다.
NEO4J_DATABASE=<AURA_DATABASE_NAME>
NEO4J_TIMEOUT_MS=1500

# Supabase PostgreSQL — Dashboard의 Connect > Session pooler URI를 사용한다.
# 이 값은 백엔드 전용이며 VITE_ 접두사를 붙이지 않는다.
TEXT2SQL_ENABLED=false
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
TEXT2SQL_TIMEOUT_MS=5000

# 금융위원회_금융회사기본정보 OpenAPI (data.go.kr) — 1층 상대방 검증 · 전화 수신 화면에서 씀.
# 발급: data.go.kr에서 "금융위원회_금융회사기본정보" 서비스 활용신청 → 인코딩된 서비스키 사용.
# 서버 전용이며 VITE_ 접두사를 붙이지 않는다(브라우저에 노출하지 않기 위함).
FSC_API_KEY=
